# ============================================
# SentinelX - ML Engineering .gitignore
# ============================================

# -------------------- Python --------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# -------------------- Virtual Environments --------------------
.venv/
venv/
ENV/
env/
.conda/
conda-env/

# -------------------- IDE / Editors --------------------
.vscode/
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

# -------------------- OS Files --------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.bak

# -------------------- Secrets & Environment --------------------
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
secrets.yaml
config.local.yaml

# -------------------- Jupyter Notebooks --------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*.ipynb_checkpoints

# -------------------- ML Data (Large Files) --------------------
# Raw data - too large for git (use DVC or git-lfs)
data/features/*.parquet
data/parquet/*.parquet
data/parquet_500k/
data/raw/*.csv
data/raw_500k/

# Keep directory structure
!data/features/.gitkeep
!data/parquet/.gitkeep
!data/raw/.gitkeep

# -------------------- ML Models & Artifacts --------------------
# Trained models (regenerate via notebooks or download from model registry)
models/*.joblib
models/*.pkl
models/*.pickle
models/*.h5
models/*.hdf5
models/*.pt
models/*.pth
models/*.onnx
models/*.pb
models/*.npy
models/*.npz

# Keep model metadata (small JSON files)
!models/*.json
!models/.gitkeep

# -------------------- Experiment Tracking --------------------
mlruns/
mlflow-artifacts/
wandb/
.neptune/
outputs/
lightning_logs/
tensorboard_logs/
*.tfevents.*

# -------------------- Testing --------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.coverage
.hypothesis/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# -------------------- Node.js (for Playwright) --------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------- Docker --------------------
# Local docker volumes (if any)
docker/volumes/
*.log

# -------------------- Database --------------------
*.db
*.sqlite
*.sqlite3
postgres-data/

# -------------------- Claude Code --------------------
.claude/

# -------------------- Misc --------------------
*.tmp
*.temp
*.bak
*.backup
.cache/
tmp/
temp/

# -------------------- Large Files Safety Net --------------------
# Prevent accidental commits of large files
*.csv
*.parquet
*.feather
*.arrow
!test_request.json

# ============================================
# FILES TO EXPLICITLY TRACK (override above)
# ============================================
# Model metadata JSON files are small and useful
!models/cv_metrics.json
!models/evaluation_results.json
!models/feature_names.json
!models/training_config.json
!models/autoencoder_metrics.json
!models/shap_importance.json

# Keep .gitkeep files to preserve directory structure
!**/.gitkeep
